<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN 2.0//EN" "https://www.springframework.org/dtd/spring-beans-2.0.dtd">
<!-- O Spring não conhece o SQLite: sem isto, violações de restrição viram UncategorizedSQLException
     (e a API devolveria 500 em vez de 409 numa corrida por IP duplicado). Códigos: sqlite.org/rescode.html -->
<beans>
  <bean id="SQLite" class="org.springframework.jdbc.support.SQLErrorCodes">
    <property name="databaseProductNames">
      <list><value>SQLite</value></list>
    </property>
    <property name="dataIntegrityViolationCodes">
      <value>19,275,787,1299,1555,2067,2579</value>
    </property>
    <property name="cannotAcquireLockCodes">
      <value>5,6,261,517</value>
    </property>
  </bean>
</beans>
