[Unit]
Description=OmniDude NMS (monitoramento de rede)
Documentation=file:///usr/share/doc/omnidude/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omnidude
Group=omnidude

# Configuração e segredos ficam em /etc/omnidude/omnidude.env (modo 0600, dono root): variáveis OMNIDUDE_* e JAVA_OPTS.
EnvironmentFile=-/etc/omnidude/omnidude.env
Environment=OMNIDUDE_DATA_DIR=/var/lib/omnidude
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment="JAVA_OPTS=-Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError"
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/omnidude/omnidude.jar

Restart=on-failure
RestartSec=5
# O encerramento é gracioso: a fila de métricas é gravada antes de sair. 143 = SIGTERM tratado pela JVM.
TimeoutStopSec=30
SuccessExitStatus=143
LimitNOFILE=65536

# Banco, chave de criptografia e backups: só o usuário do serviço (0700), criados por conta do systemd.
StateDirectory=omnidude
StateDirectoryMode=0700
UMask=0077

# --- Isolamento ---------------------------------------------------------------------------------------------------
# O serviço só precisa de rede, do próprio diretório de estado e de CAP_NET_RAW (o ping do sistema, para as checagens ICMP).
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# AF_NETLINK: a JVM lê as interfaces de rede; AF_INET/AF_INET6: tudo que o serviço faz (SNMP, sondas, HTTP, SMTP).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# NÃO ligar MemoryDenyWriteExecute: o compilador JIT da JVM precisa de páginas graváveis e executáveis.

[Install]
WantedBy=multi-user.target
